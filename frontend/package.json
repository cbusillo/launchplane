{
  "name": "@launchplane/operator-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm typecheck && vite build && node scripts/assert-production-fixtures.mjs",
    "dev": "pnpm generate:openapi-types && vite --host 127.0.0.1",
    "generate:agent-contract": "uv run launchplane service export-agent-contract --output ../contracts/agent-operator-contract.json",
    "generate:openapi": "pnpm generate:openapi-types && pnpm generate:agent-contract",
    "generate:openapi-types": "pnpm generate:openapi-schemas && node scripts/generate-openapi-types.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check:openapi-drift": "node scripts/check-openapi-drift.mjs",
    "test": "pnpm generate:openapi-schemas && node --experimental-strip-types --import ./tests/register-typescript.mjs --test tests/*.test.mjs",
    "test:browser": "pnpm generate:openapi-types && pnpm test:browser:prepared",
    "typecheck": "pnpm generate:openapi-types && tsc --noEmit && tsc --project tsconfig.node.json",
    "validate": "pnpm check:browser-timing && pnpm test && pnpm check:openapi-drift && pnpm build",
    "check:browser-timing": "node scripts/check-browser-timing.mjs && pnpm typecheck:browser-support",
    "typecheck:browser-support": "pnpm generate:openapi-types && tsc --project tsconfig.browser-support.json",
    "generate:openapi-schemas": "uv run launchplane service export-openapi --output generated/openapi-canonical.json && node scripts/build-openapi-ui-schema.mjs",
    "test:browser:prepared": "node scripts/check-browser-timing.mjs && tsc --project tsconfig.browser-support.json && node scripts/prepare-browser-smoke.mjs && node --test tests/browser-support/*.test.mjs && node scripts/run-browser-smoke.mjs"
  },
  "dependencies": {
    "lucide-react": "1.54.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
